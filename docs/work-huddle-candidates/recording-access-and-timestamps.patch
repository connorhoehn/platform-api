+import express, { type Request, type Response, type NextFunction } from 'express';
+
+const mockUser: { sub: string; orgId: string; authKind: string; tenants: string[]; userId?: string } = { sub: 'u-1', orgId: 'orgiq', authKind: 'orgiq-hs256', tenants: ['orgiq', 'assessment'] };
+const mockListByUser = jest.fn();
+const mockListByLobbyName = jest.fn();
+const mockAuthority = jest.fn();
+const mockRoom = jest.fn();
+const mockMember = jest.fn();
+
+jest.mock('../../middleware/auth', () => ({
+  requireAuth: (req: Request, _res: Response, next: NextFunction) => { req.user = { ...mockUser } as Request['user']; next(); },
+}));
+jest.mock('../../recordings/recordingPipelines', () => ({ startSystemRun: jest.fn(), buildCallTranscriptionDefinition: jest.fn(), documentIdForLobby: jest.fn() }));
+jest.mock('../../repositories', () => ({
+  callRecordingRepo: {
+    listByUser: (...args: unknown[]) => mockListByUser(...args),
+    listByLobbyName: (...args: unknown[]) => mockListByLobbyName(...args),
+  },
+  hangoutRoomRepo: { getRoomBySlug: (...args: unknown[]) => mockRoom(...args) },
+  hangoutRoomMemberRepo: { listMembers: async () => [] },
+  describeMedia: jest.fn(),
+}));
+jest.mock('../../lib/lobbyAccess', () => {
+  const real = jest.requireActual('../../lib/lobbyAccess');
+  const access = real.makeLobbyAccess({
+    roomBySlug: (...args: unknown[]) => mockRoom(...args),
+    isRoomMember: (...args: unknown[]) => mockMember(...args),
+    isChannelMember: async () => false,
+    documentExists: async () => false,
+    assertCanReadDocument: async () => { throw new Error('No document'); },
+    orgiqLobbyAuthority: (...args: unknown[]) => mockAuthority(...args),
+    governedTenant: () => true,
+  });
+  return { ...real, lobbyAccess: () => access };
+});
+jest.mock('../../lib/aws-clients', () => ({ docClient: { send: jest.fn() } }));
+jest.mock('../../lib/sfu-breaker', () => ({ callSfu: jest.fn(), mapSfuError: jest.fn() }));
+
+import { recordingsRouter } from '../recordings';
+import { errorHandler } from '../../middleware/error-handler';
+
+async function get(query: Record<string, string>) {
+  const app = express(); app.use('/api', recordingsRouter); app.use(errorHandler);
+  let finish!: () => void;
+  const done = new Promise<void>(resolve => { finish = resolve; });
+  const res = {
+    statusCode: 200, body: undefined as unknown, ended: false,
+    status(code: number) { this.statusCode = code; return this; },
+    json(body: unknown) { this.body = body; this.ended = true; finish(); return this; },
+    setHeader() {}, getHeader() { return undefined; },
+    end() { this.ended = true; finish(); return this; },
+  };
+  const req = { method: 'GET', url: '/api/recordings', originalUrl: '/api/recordings', path: '/api/recordings', headers: {}, query, body: {}, params: {}, ip: '127.0.0.1' } as unknown as Request;
+  (app as unknown as (req: Request, res: Response, next: NextFunction) => void)(req, res as unknown as Response, (err?: unknown) => {
+    if (err) throw err;
+    if (!res.ended) res.status(404).json({ error: 'not found' });
+  });
+  await done;
+  return res;
+}
+const lobby = 'orgiq:initiative:p-observability';
+const row = (id: string, lobbyName = lobby) => ({ recordingId: id, callId: `call-${id}`, lobbyName, composeStatus: 'skipped', transcriptStatus: 'none' });
+beforeEach(() => {
+  delete mockUser.userId;
+  jest.clearAllMocks(); mockAuthority.mockReset().mockResolvedValue(true);
+  mockRoom.mockReset().mockResolvedValue(null); mockMember.mockReset().mockResolvedValue(false);
+  mockListByUser.mockReset().mockResolvedValue({ items: [], cursor: undefined });
+  mockListByLobbyName.mockReset().mockResolvedValue({ items: [], cursor: undefined });
+});
+
+describe('governed recording list: page access plus participation', () => {
+  it('uses authenticated participant rows and exact lobby filtering, never the wider lobby index', async () => {
+    mockListByUser.mockResolvedValue({ items: [row('own'), row('other', 'orgiq:initiative:p-other')], cursor: 'own-next' });
+    const res = await get({ lobbyName: lobby, limit: '5', cursor: 'own-before' });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toMatchObject({ items: [{ recordingId: 'own' }], cursor: 'own-next' });
+    expect((res.body as { items: unknown[] }).items).toHaveLength(1);
+    expect(mockListByUser).toHaveBeenCalledWith('u-1', { limit: 5, cursor: 'own-before' });
+    expect(mockListByLobbyName).not.toHaveBeenCalled();
+    expect(mockAuthority).toHaveBeenCalledWith(expect.objectContaining({ user: expect.objectContaining({ sub: 'u-1' }) }), lobby);
+  });
+  it('binds participant lookup to the same authenticated subject used by lobby authority', async () => {
+    mockUser.userId = 'different-legacy-alias';
