+    expect(mockListByUser).toHaveBeenCalledWith('u-1', { limit: 20, cursor: undefined });
+  });
+  it('retains keyset progress on empty pages and reaches matching later entries', async () => {
+    mockListByUser.mockResolvedValueOnce({ items: [row('other', 'orgiq:initiative:p-other')], cursor: 'next' })
+      .mockResolvedValueOnce({ items: [row('found')], cursor: undefined });
+    expect((await get({ lobbyName: lobby })).body).toEqual({ items: [], cursor: 'next' });
+    expect((await get({ lobbyName: lobby, cursor: 'next' })).body).toMatchObject({ items: [{ recordingId: 'found' }], cursor: null });
+    expect(mockListByUser).toHaveBeenCalledTimes(2);
