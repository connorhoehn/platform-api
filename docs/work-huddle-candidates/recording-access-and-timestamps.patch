+/** Native signer only. Recording participation/share authority is decided by
+ * the caller before this hop; live visibility and channel lifetime are irrelevant. */
+async function mintRecordingCapability(detail: CallRecording, shareNotAfter?: number): Promise<{ token: string; expiresAt: string }> {
+  const notAfter = [detail.ttl, shareNotAfter].filter((v): v is number => v !== undefined);
+  if (notAfter.some(v => !Number.isSafeInteger(v) || v <= Math.floor(Date.now() / 1000))) throw new NotFoundError('recording playback expired');
+  const deadline = notAfter.length ? Math.min(...notAfter) : undefined;
+  try {
+    const lvsRes = await callSfu(
+      `${VIDEO_API_URL}/api/channels/${encodeURIComponent(detail.channelArn)}/recordings/${encodeURIComponent(detail.recordingId)}/playback-tokens`,
+      { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${process.env.VIDEO_ADMIN_TOKEN || 'admin'}` },
+        body: JSON.stringify({ ttlSeconds: 3600, ...(deadline !== undefined ? { notAfter: deadline } : {}) }) },
+    );
+    // A public/expired channel never makes a recorded artifact public. No
+    // fallback to an unsigned URL when the native signer refuses the mint.
+    if (!lvsRes.ok) {
+      const text = await lvsRes.text().catch(() => '');
+      throw new AppError(502, `LVS recording playback-token mint failed: ${lvsRes.status}${text ? ` — ${text.slice(0, 200)}` : ''}`);
+    }
+    const capability = await lvsRes.json() as { token?: unknown; expiresAt?: unknown };
+    const expiresMs = typeof capability.expiresAt === 'string' ? Date.parse(capability.expiresAt) : NaN;
+    if (typeof capability.token !== 'string' || !capability.token || !Number.isFinite(expiresMs) || expiresMs <= Date.now()
+        || expiresMs > Date.now() + 3600000 + 1000 || (deadline !== undefined && expiresMs > deadline * 1000)) throw new AppError(502, 'LVS returned an invalid recording playback capability');
+    return { token: capability.token, expiresAt: capability.expiresAt as string };
+  } catch (error) {
+    log.error({ errorName: error instanceof Error ? error.name : 'Error', recordingId: detail.recordingId }, '[recordings] recording playback-token mint failed');
+    if (error instanceof AppError) throw error;
+    throw mapSfuError(error);
+  }
+}
