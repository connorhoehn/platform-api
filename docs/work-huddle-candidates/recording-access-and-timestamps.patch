+  it.each(['deny', 'failure'])('refuses page authority %s before reading recordings', async failure => {
+    if (failure === 'deny') mockAuthority.mockResolvedValue(false);
+    else mockAuthority.mockRejectedValue(new Error('authority unavailable'));
+    expect((await get({ lobbyName: lobby })).statusCode).toBe(404);
+    expect(mockListByUser).not.toHaveBeenCalled(); expect(mockListByLobbyName).not.toHaveBeenCalled();
+  });
+  it('refuses a foreign tenant even if the external authority would allow it', async () => {
+    expect((await get({ lobbyName: 'foreign:initiative:p-other' })).statusCode).toBe(404);
+    expect(mockAuthority).not.toHaveBeenCalled(); expect(mockListByUser).not.toHaveBeenCalled();
+  });
+  it('keeps private namespaced room membership checks before the participant query', async () => {
+    mockRoom.mockResolvedValue({ roomId: 'r-1', orgId: 'orgiq', visibility: 'private', createdBy: 'u-other' });
+    expect((await get({ lobbyName: 'orgiq:room:private' })).statusCode).toBe(403);
+    expect(mockListByUser).not.toHaveBeenCalled();
+  });
+  it('does not widen a legacy DM or private room', async () => {
+    expect((await get({ lobbyName: 'dm:u-other:u-stranger' })).statusCode).toBe(404);
+    expect((await get({ lobbyName: 'room:private' })).statusCode).toBe(403);
+    expect(mockListByUser).not.toHaveBeenCalled(); expect(mockListByLobbyName).not.toHaveBeenCalled();
+  });
+  it('keeps the unfiltered participant list unchanged', async () => {
+    mockListByUser.mockResolvedValue({ items: [row('own')], cursor: undefined });
+    expect((await get({})).body).toMatchObject({ items: [{ recordingId: 'own' }], cursor: null });
+    expect(mockAuthority).not.toHaveBeenCalled(); expect(mockListByLobbyName).not.toHaveBeenCalled();
+  });
+});
