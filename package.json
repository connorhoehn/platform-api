{
  "name": "@connorhoehn/platform-api",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Application platform API — user management, content, pipelines, social features",
  "scripts": {
    "dev": "VIDEO_API_URL=http://localhost:3901 VIDEO_PUBLIC_URL=http://localhost:3901 COGNITO_REGION=us-east-1 COGNITO_USER_POOL_ID=us-east-1_localdev000 SKIP_AUTH=true PIPELINE_LLM_PROVIDER=claude-code LOCALSTACK_ENDPOINT=http://localhost:8000 REDIS_ENDPOINT=localhost AWS_REGION=us-east-1 ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "lint:openapi": "node scripts/openapi-coverage-lint.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1030.0",
    "@aws-sdk/client-dynamodb": "^3.1010.0",
    "@aws-sdk/client-eventbridge": "^3.1011.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/client-sqs": "^3.1011.0",
    "@aws-sdk/lib-dynamodb": "^3.1010.0",
    "@connorhoehn/event-catalog": "github:connorhoehnslalom/event-catalog#b758fb7dcd7b915119d5914cc670578c057af223",
    "@connorhoehn/pipeline-runtime": "github:connorhoehn/pipeline-runtime#f8d4c07c4ba77f1474684385c66a006f00c8593f",
    "@connorhoehn/realtime-modules": "github:connorhoehn/realtime-modules#c002e5e86f61bad8c6534826561f55d6471f0a8d",
    "@connorhoehn/service-runtime": "github:connorhoehn/service-runtime#c01db0e6dfe0e6b91081ae92ee5cc3c1e77d2ad6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@types/uuid": "^10.0.0",
    "csv-parse": "^6.2.1",
    "distributed-core": "github:connorhoehn/distributed-core#eea5c874766dea15b8b1f58b969af991b289a42c",
    "express": "^4.18.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "multer": "^2.1.1",
    "pino": "^9.14.0",
    "pptxgenjs": "4.0.1",
    "redis": "^5.0.0",
    "sharp": "^0.34.5",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^4.1.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "google-auth-library": "10.5.0",
    "distributed-core": "$distributed-core"
  }
}
