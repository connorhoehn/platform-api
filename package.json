{
  "name": "@connorhoehn/platform-api",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Application platform API — user management, content, pipelines, ingest, social features",
  "scripts": {
    "dev": "COGNITO_REGION=us-east-1 COGNITO_USER_POOL_ID=us-east-1_localdev000 SKIP_AUTH=true LOCALSTACK_ENDPOINT=http://localhost:8000 REDIS_ENDPOINT=localhost AWS_REGION=us-east-1 ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1030.0",
    "@aws-sdk/client-dynamodb": "^3.1010.0",
    "@aws-sdk/client-eventbridge": "^3.1011.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/client-sqs": "^3.1011.0",
    "@aws-sdk/lib-dynamodb": "^3.1010.0",
    "@connorhoehn/event-catalog": "github:connorhoehnslalom/event-catalog#v0.3.18",
    "@connorhoehn/pipeline-runtime": "github:connorhoehn/pipeline-runtime#v0.1.0",
    "@connorhoehn/service-runtime": "github:connorhoehn/service-runtime#v0.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@types/uuid": "^10.0.0",
    "csv-parse": "^6.2.1",
    "distributed-core": "github:connorhoehn/distributed-core#v0.19.6",
    "express": "^4.18.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "multer": "^2.1.1",
    "pino": "^9.14.0",
    "redis": "^5.0.0",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.0.0"
  }
